{
	"openapi": "3.0.2",
	"info": {
		"title": "mia-vlc-read-sound",
		"version": "1.0.0",
  		"description": "Read sound with VLC."
	},
	"paths": {

		"/mia-vlc-read-sound/api/descriptor": {
			"get": {
				"description": "",
				"summary": "Plugin's descriptor",
				"operationId": "getPluginDescriptor",
				"security": [
					{ "bearerAuth": [] }
				],
				"responses": {
					"200": {
						"description": "Plugin's descriptor",
						"content": {
							"application/json": {
								"schema": {
									"type": "object"
								}
							}
						}
					},
					"default": {
						"description": "An error occurred",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/Error"
								}
							}
						}
					}
				}
			}
		},
		"/mia-vlc-read-sound/api/status": {
			"get": {
				"description": "",
				"summary": "Plugin's status",
				"operationId": "getPluginStatus",
				"security": [
					{ "bearerAuth": [] }
				],
				"responses": {
					"200": {
						"description": "Plugin's status",
						"content": {
							"application/json": {
								"schema": {
									"type": "string",
									"enum": [ "ENABLED", "INITIALIZED", "RELEASED" ]
								}
							}
						}
					},
					"404": {
						"description": "The plugin is not enabled (=RELEASED)",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/Error"
								}
							}
						}
					},
					"default": {
						"description": "An error occurred",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/Error"
								}
							}
						}
					}
				}
			}
		},

		"/mia-vlc-read-sound/public/index.html": {
			"get": {
				"description": "",
				"summary": "Plugin's front",
				"operationId": "getFrontIndex",
				"responses": {
					"200": {
						"description": "Plugin's front",
						"content": {
							"text/html": {
								"schema": {
									"type": "string"
								}
							}
						}
					},
					"default": {
						"description": "An error occurred",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/Error"
								}
							}
						}
					}
				}
			}
		},
		"/mia-vlc-read-sound/public/bundle.min.js": {
			"get": {
				"description": "",
				"summary": "Plugin's front app",
				"operationId": "getFrontApp",
				"responses": {
					"200": {
						"description": "Plugin's front app",
						"content": {
							"application/javascript": {
								"schema": {
									"type": "string"
								}
							}
						}
					},
					"default": {
						"description": "An error occurred",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/Error"
								}
							}
						}
					}
				}
			}
		},
		"/mia-vlc-read-sound/public/bundle.min.js.map": {
			"get": {
				"description": "",
				"summary": "Plugin's front app map",
				"operationId": "getFrontAppMap",
				"responses": {
					"200": {
						"description": "Plugin's front app",
						"content": {
							"application/json": {
								"schema": {
									"type": "object",
									"additionalProperties": true
								}
							}
						}
					},
					"default": {
						"description": "An error occurred",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/Error"
								}
							}
						}
					}
				}
			}
		},

		"/mia-vlc-read-sound/api/read-sound": {
			"put": {
				"description": "",
				"summary": "Read sound with VLC",
				"operationId": "readSound",
				"security": [
					{ "bearerAuth": [] }
				],
				"requestBody": {
					"required": true,
					"content": {
						"application/json": {
							"schema": {
								"type": "object",
								"properties": {
									"sound": {
										"type": "string"
									}
								},
								"required": [ "sound" ]
							}
						}
					}
				},
				"responses": {
					"201": {
						"description": "Everything is fine",
						"content": {
							"application/json": {}
						}
					},
					"default": {
						"description": "An error occurred",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/Error"
								}
							}
						}
					}
				}
			}
		}

	},
	"components": {
		"securitySchemes": {
			"bearerAuth": {
				"type": "http",
				"scheme": "bearer",
				"bearerFormat": "JWT"
			}
		},
		"schemas": {
			"PluginName": {
				"type": "string",
				"enum": [ "mia-vlc-read-sound" ]
			},
			"Error": {
				"type": "object",
				"description": "JSON Error description",
				"properties": {
					"code": {
						"type": "string"
					},
					"message": {
						"type": "string"
					}
				},
				"required": [ "code", "message" ]
			},
			"PushEventPluginInitialized": {
				"$ref": "./DescriptorEvents.json#/components/schemas/PushEventPluginInitialized"
			},
			"PushEventPluginReleased": {
				"$ref": "./DescriptorEvents.json#/components/schemas/PushEventPluginReleased"
			},
			"PushEventPluginError": {
				"$ref": "./DescriptorEvents.json#/components/schemas/PushEventPluginError"
			}
		}
	},
	"servers": [
		{
			"url": "http://localhost:8000/",
			"description": "test server"
		}
	]
}
